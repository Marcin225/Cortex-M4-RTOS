{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Target Tests",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "build-target-tests"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": "build"
        }
    ]
}